{
  "name": "og-lab-be",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "watch": "tsc-watch --project tsconfig.build.json --onSuccess \"node --env-file-if-exists=.env dist/index.js\"",
    "db:start:local": "supabase start",
    "db:stop:local": "supabase stop",
    "db:reset:local": "supabase db reset --local",
    "db:push:local": "supabase db push --local",
    "db:migration:list:remote": "supabase migration list --project-ref",
    "db:push:remote:dry-run": "supabase db push --dry-run --skip-vault --project-ref",
    "db:push:remote": "supabase db push --skip-vault --project-ref",
    "db:migration:new": "supabase migration new",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "check": "npm run lint && npm run typecheck && npm test -- --ci && npm run build",
    "pipeline": "npm ci && npm run check && npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "overrides": {
    "js-yaml@3.15.2": {
      "argparse": "2.0.1"
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "supabase": "^2.121.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsc-watch": "^7.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
